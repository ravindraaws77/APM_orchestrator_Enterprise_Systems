# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — never commit real credentials.

# --- apm_connectors (this repo's only dependency on the outside world) ---
# Base URL of a running apm_connectors API (see that repo's
# docs/running-locally.md), e.g. http://127.0.0.1:8000 locally.
APM_CONNECTORS_BASE_URL=http://127.0.0.1:8000

# If that server has APM_API_KEYS configured, set one of those keys here
# so every call this repo makes authenticates and is attributed to a
# caller name in apm_connectors' audit trail (proposed_by/caller).
# Leave unset only if the target server has no auth configured.
APM_CONNECTORS_API_KEY=

# --- Anthropic / Claude Agent SDK ---
# Used by both the Supervisor and every specialized agent (e.g.
# Order-Renewal). See https://docs.claude.com for how to obtain a key.
ANTHROPIC_API_KEY=

# Model + per-call budget for the Supervisor (routing only -- one
# delegate-or-decline decision per call) and the business agents
# (Order-Renewal/Customer-Onboarding -- multi-step tool orchestration).
# Both default to claude-sonnet-5 if unset -- explicit and pinned,
# rather than silently inheriting whatever the local Claude Code CLI's
# own default happens to be. max_budget_usd is a per-call dollar
# backstop against a runaway loop, not a tuned production number; raise
# it if a legitimate real workflow ever hits the ceiling.
SUPERVISOR_MODEL=claude-sonnet-5
BUSINESS_AGENT_MODEL=claude-sonnet-5
SUPERVISOR_MAX_BUDGET_USD=0.50
BUSINESS_AGENT_MAX_BUDGET_USD=2.00

# --- Order-Renewal agent policy ---
# Path to the YAML file defining what counts as "a renewal", SLA
# windows, and blocking-ticket rules -- kept as data, not code, so a
# policy change never needs a code change. Defaults to the bundled
# policy.yaml next to the agent if unset.
ORDER_RENEWAL_POLICY_PATH=

# --- Durable per-case state (Postgres) ---
# Required to run a business-process case graph (e.g.
# agents/order_renewal/case_graph.py) or the poller (poller.py) --
# neither works without it, unlike the rest of this repo. A standard
# "postgresql://user:password@host:port/dbname" URL. Needs the optional
# `postgres` extra: pip install -e ".[postgres]".
#
# This is a *separate* database from whatever apm_connectors' own
# DATABASE_URL points at (see that repo's .env.example) -- two
# independent LangGraph checkpointers for two independent graphs, one
# per repo, never shared.
DATABASE_URL=
